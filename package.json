{
  "name": "monitoreo-cuencas-jujuy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/publish-data.mjs",
    "data:publish": "node scripts/publish-data.mjs",
    "build": "next build",
    "prebuild": "node scripts/publish-data.mjs",
    "start": "node scripts/serve-static.mjs 3000",
    "start:static": "node scripts/serve-static.mjs 3000",
    "start:api": "node server/index.js",
    "dev:api": "node --watch server/index.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:unit": "node --test tests/*.test.ts",
    "test:py": "node scripts/test-python.mjs",
    "test:e2e": "playwright test",
    "validate:data": "npm run test:py && node --test tests/publish.test.ts",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test && npm run test:py && npm run test:e2e:smoke",
    "pretest": "node scripts/publish-data.mjs",
    "test:e2e:smoke": "playwright test --project=smoke --global-timeout=120000 --retries=0",
    "brand:assets": "node scripts/brand/generate-brand-assets.mjs",
    "brand:steps": "node scripts/brand/capture-step-thumbnails.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
